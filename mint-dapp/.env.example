# ─── Active network ────────────────────────────────────────────────
# anvil = local blockchain on your machine (default, no wallet/faucet needed)
# fuji  = the real Avalanche Fuji testnet (needs a Core/MetaMask wallet + test AVAX)
NEXT_PUBLIC_CHAIN=anvil

# ─── Contract address ──────────────────────────────────────────────
# This line is written automatically, don't edit it by hand:
#   npm run deploy:anvil            → deploy to the local chain
#   npm run set-contract 0x...      → point to a contract deployed with Remix
#   npm run deploy:fuji             → deploy to Fuji with a private key
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ─── anvil RPC (optional) ──────────────────────────────────────────
# Only needed when port 8545 is already taken by another process:
#   ANVIL_PORT=8546 npm run anvil
#   NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8546
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# ─── Deployer wallet ───────────────────────────────────────────────
# ONLY needed for `npm run deploy:fuji`. If you deploy with Remix (recommended
# for demos) or run anvil, leave it EMPTY — no key ever sits on your machine.
# ⚠️ Use a separate TESTNET wallet, NEVER your real wallet, and NEVER commit .env.local!
DEPLOYER_PRIVATE_KEY=

# ─── KPI collection (optional) ─────────────────────────────────────
# URL of the Google Apps Script web app that receives the Step 3 form. Leave it
# empty and the form still shows but sends nothing. Setup: see the README
# section "Collecting KPIs".
NEXT_PUBLIC_KPI_ENDPOINT=

# ─── WalletConnect (needed for MOBILE wallets) ─────────────────────
# Core mobile / MetaMask mobile don't inject a wallet into Safari/Chrome; they
# connect via WalletConnect. Create a free project at https://dashboard.reown.com
# and paste the Project ID here. Leave it empty and the WalletConnect button is hidden.
NEXT_PUBLIC_WC_PROJECT_ID=

# ─── Faucet riêng (tuỳ chọn) ───────────────────────────────────────
# URL của Cloudflare Worker trong faucet-worker/. Có giá trị thì nút "Get test AVAX"
# cạnh "Create L1" sẽ gửi AVAX test thẳng vào ví đang kết nối; để trống thì nút chỉ
# link sang faucet Builder Hub. Xem faucet-worker/README.md.
NEXT_PUBLIC_FAUCET_ENDPOINT=

# ─── Đăng nhập Google cho form đăng ký (tuỳ chọn) ──────────────────
# OAuth Client ID tạo ở Google Cloud Console (loại "Web application"), thêm
# https://team1vn.xyz và http://localhost:3000 vào Authorized JavaScript origins.
# Có giá trị thì form hiện nút "Continue with Google" tự điền Gmail + tên đã xác minh;
# để trống thì form gõ tay như cũ. Client ID là thông tin công khai, không phải secret.
# Xem docs/google-signin.md để biết cách verify token phía server.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
